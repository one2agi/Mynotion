{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "bash scripts/vercel-install.sh",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jichang.world"
        }
      ],
      "destination": "https://www.jichang.world/:path*",
      "statusCode": 301
    }
  ]
}
